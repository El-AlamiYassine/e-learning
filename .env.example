# Database (Postgres) settings
POSTGRES_DB=e_learning_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Spring datasource example for running in Docker Compose
# Spring Boot JDBC URL format: jdbc:postgresql://<host>:<port>/<db>
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/e_learning_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
